        <script><![CDATA[(function executeRule(current, previous /* null when async */) {

    if (current.warranty_plan.nil()) {
        current.term_months = '';
        current.coverage_mileage_limit = '';
        current.deductible_amount = '';
        return;
    }

    var plan = current.warranty_plan.getRefRecord();

    if (plan && plan.isValidRecord()) {

        current.term_months =
            plan.term_months;

        current.coverage_mileage_limit =
            plan.coverage_mileage_limit;

        current.deductible_amount =
            plan.deductible_amount;
    }

})(current, previous);]]></script>
