        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    if (current.vin.nil()) return;

    var vinGR = current.vin.getRefRecord();
    if (!vinGR.isValidRecord()) return;

    // Dono taraf lowercase, isliye case ka mismatch nahi hoga
    var approvalCompanies = ['ferrari', 'volkswagen'];

    // Inventory table ka Company Name column (dictionary se confirmed)
    var company = (vinGR.getDisplayValue('company_name') || '').toString().trim().toLowerCase();

    var needsApproval = approvalCompanies.indexOf(company) > -1;

    current.approval_status = needsApproval ? 'requested' : 'approved';

    gs.info('AUTOAPPROVE | company: [' + company + '] | needsApproval: ' + needsApproval);
    gs.addInfoMessage('Company: [' + company + '] -> ' + current.approval_status);   // test ke baad ye line hata dena

})(current, previous);]]></script>
